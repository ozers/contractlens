{
  "name": "contractlens",
  "version": "0.1.2",
  "description": "Catch API breaking changes before your users do. Lightweight runtime API contract validation for Node.js.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "api",
    "contract",
    "validation",
    "openapi",
    "swagger",
    "middleware",
    "express",
    "fastify",
    "microservices",
    "drift-detection",
    "breaking-changes",
    "runtime-validation",
    "schema-validation",
    "pact-alternative"
  ],
  "author": "Ozer Subasi (https://github.com/ozers)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozers/contractlens.git"
  },
  "bugs": {
    "url": "https://github.com/ozers/contractlens/issues"
  },
  "homepage": "https://github.com/ozers/contractlens#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "express": "^5.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
